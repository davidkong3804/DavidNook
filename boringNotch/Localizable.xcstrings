          }
        }
      }
    },
    "DavidNook is an independent implementation and is not affiliated with NotchNook or its authors." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DavidNook 為獨立實作，與 NotchNook 及其作者無關。"
          }
        }
      }
    },
    "DavidNook is free software released under the GNU General Public License v3.0 (GPL-3.0). It comes with no warranty of any kind." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DavidNook 是自由軟體，依 GNU 通用公共授權條款第 3 版（GPL-3.0）發佈，不提供任何形式的擔保。"
          }
        }
      }
    },
    "DavidNook lost its Now Playing connection. Reconnecting automatically..." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DavidNook 與「正在播放」的連線中斷，正在自動重新連線…"
          }
        }
      }
    },
    "DavidNook turns the notch into a small control center. Everything stays on this Mac; the only network connection is lrclib.net, for lyrics." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DavidNook 讓瀏海變成小型控制中心。資料都只留在這台 Mac，唯一的對外連線是查詢歌詞用的 lrclib.net。"
          }
        }
      }
    },
    "DavidNook's Now Playing components are unavailable. Reopen or reinstall the app." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DavidNook 的「正在播放」元件無法使用。請重新開啟或重新安裝 App。"
          }
        }
      }
