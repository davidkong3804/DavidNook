{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Shown in the macOS Automation permission prompt for the Music app.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DavidNook uses Apple events to read the current track, favorite state and volume of the Music app and to control its playback. This only happens when Now Playing information is unavailable, or when the Music app is the one playing."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DavidNook 透過 Apple 事件讀取「音樂」App 目前的曲目、喜好項目與音量，並控制其播放。只有在「正在播放」資訊無法使用，或正在播放的是「音樂」App 時才會用到。"
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription" : {
      "comment" : "Shown by macOS when DavidNook is allowed to show a picked window as live video.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DavidNook shows a live, scaled-down picture of the one window you pick inside the notch. The picture stays in memory only; it is never saved or uploaded, and no sound is captured."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DavidNook 會在瀏海裡顯示你挑選的那一個視窗的即時縮小畫面。畫面只存在記憶體中，不會儲存或上傳，也不會擷取聲音。"
          }
        }
      }
    }
  },
  "version" : "1.1"
}
